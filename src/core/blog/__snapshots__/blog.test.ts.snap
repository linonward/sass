exports[`RSS > RSS 2.0 输出，转义标题和描述 1`] = `
"<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>Acme Blog</title>
    <link>https://<domain>/de/blog</link>
    <description>News &amp; updates</description>
    <language>de</language>
    <atom:link href="https://<domain>/de/blog/rss.xml" rel="self" type="application/rss+xml" />
    <lastBuildDate>Mon, 02 Feb 2026 00:00:00 GMT</lastBuildDate>
    <item>
      <title>Hallo</title>
      <link>https://<domain>/de/blog/hello</link>
      <guid isPermaLink="true">https://<domain>/de/blog/hello</guid>
      <pubDate>Mon, 02 Feb 2026 00:00:00 GMT</pubDate>
      <description>About hello &amp; more</description>
      <category>news</category>
    </item>
  </channel>
</rss>
"
`;

