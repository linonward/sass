# Copy this file to .env.local and fill it in. Each module's variables are grouped below.

# Site identity: site.config.ts ships with placeholder values; editing that file directly is enough.
# The group below is for overriding them when one codebase serves several environments (the
# template's demo site keeps its real values this way, so they never have to be committed). You
# usually don't need them; when set, they take precedence.
# If neither these variables nor site.config.ts are changed, the production build fails because
# of the placeholder values (see src/core/config/sentinels.ts).
# Product name (`name` in site.config.ts). The official demo sets it to OnwardKit; use your own
# product name.
SITE_NAME=
# Site domain, without the protocol (`domain` in site.config.ts).
SITE_DOMAIN=
# Company or individual name shown on the legal pages (`legal.companyName` in site.config.ts).
SITE_LEGAL_NAME=
# Email sender address (`email.fromAddress` in site.config.ts). Its domain must match the one
# verified with your email provider.
SITE_EMAIL_FROM=
# Contact address customers write to: shown on the legal pages (`legal.contactEmail` in
# site.config.ts) and used as the Reply-To of transactional email (`email.replyTo`).
SITE_CONTACT_EMAIL=
# List price overrides (`billing.plans[*].price` in site.config.ts), named by plan id:
# SITE_PRICE_PRO / SITE_PRICE_LIFETIME.
# These only change the price shown on the site; the amount actually charged is the product price
# in your payment provider's dashboard, so keep the two in sync.
SITE_PRICE_PRO=
SITE_PRICE_LIFETIME=
# Hidden plans (comma-separated plan ids, e.g. pro): not shown on the pricing page, landing page,
# or llms.txt, and cannot be newly purchased; existing subscriptions keep working.
SITE_HIDDEN_PLANS=
# Set to 1 to turn on selling downloadable files (`downloads` in site.config.ts,
# src/features/downloads/): users who bought the matching plan download from /downloads, and the
# download page link is emailed after payment. Requires the R2_* variables; publish versions with
# pnpm downloads:publish.
SITE_DOWNLOADS=
# One-sentence product description (`description` in site.config.ts) for search results, share
# cards and llms.txt.
SITE_DESCRIPTION=
# A directory (relative to the project root) whose site.json and messages/<locale>.json replace the
# home page config and copy for this deployment only; see src/core/config/overlay.ts. Leave empty
# to use site.config.ts and messages/ as they are.
SITE_OVERLAY_DIR=
# Plan product IDs (`billing.plans[*].providerProductId` in site.config.ts), available after you
# create the products in your payment provider's dashboard.
# The variable names follow the active provider (`billing.provider` in site.config.ts, which
# BILLING_PROVIDER can override at runtime):
# creem uses prod_*, stripe uses the Price's price_* (a monthly recurring price for the
# subscription, a one-time price for lifetime), lemonsqueezy uses the variant ID, created under
# "Variants" on the product page, and waffo uses PROD_*.
# While a placeholder (prod_placeholder_*) is left in place, that plan can't be checked out and
# the API returns plan_not_configured.
CREEM_PRODUCT_ID_PRO=
CREEM_PRODUCT_ID_LIFETIME=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_LIFETIME=
LEMONSQUEEZY_VARIANT_ID_PRO=
LEMONSQUEEZY_VARIANT_ID_LIFETIME=
WAFFO_PRODUCT_ID_PRO=
WAFFO_PRODUCT_ID_LIFETIME=

# Database: Postgres connection URL (required). Locally you can start one with Docker:
#   docker run -d --name sass-postgres -e POSTGRES_PASSWORD=postgres -p 5432:5432 postgres:18
# A second product on the same machine needs its own container name and port (e.g.
# --name shop-postgres -p 5433:5432, then localhost:5433 below).
# Neon URLs (*.neon.tech) automatically use the WebSocket driver.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
# Database used by tests that need one (optional; those tests are skipped when unset, but CI must
# set it).
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5432/postgres
# How email is sent: resend | console | file.
# When unset: resend in production (including Vercel previews), console (prints to the terminal)
# locally.
# The production runtime (VERCEL_ENV or NODE_ENV is production) only allows resend; console / file
# fail at startup, because they write sign-in verification codes to server logs or disk, which
# must not happen in a deployed environment.
EMAIL_TRANSPORT=
# Explicitly allow console / file in the production runtime (optional, off by default): only
# 1 / true count as on; 0 / false or unset mean off.
# CI's e2e runs against a production build and reads verification codes from .tmp/emails/, so it
# must set this; you can also set it to run a production build locally without an email API key.
ALLOW_NON_RESEND_EMAIL=
# Resend API key (starts with re_). Required when EMAIL_TRANSPORT is resend.
RESEND_API_KEY=
# Sign-in (Better Auth): secret used to sign sessions (required, at least 32 characters).
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Site URL (optional). When unset: inferred from the request URL locally; on Vercel, the
# production domain or the URL of the current deployment.
BETTER_AUTH_URL=
# Google sign-in (optional; required in Vercel production). When unset, the sign-in page only
# offers email verification-code sign-in.
# Once set, the sign-in page also shows the One Tap prompt — it requires the current origin to be
# listed under Authorized JavaScript origins in Google Cloud Console (see the Google sign-in
# section of the README); if it isn't, the prompt silently doesn't appear.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Payments: required in Vercel production when the site has paid plans; locally, when unset, the
# checkout and webhook endpoints return 503.
# Only the group for the **active** provider is required (with Creem you don't need Stripe's, and
# vice versa).
# Creem: get these under Developers in the Creem dashboard; test mode and live mode have different
# keys and webhook secrets.
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
# test (default; uses test-api.creem.io with test cards) or live (real charges).
CREEM_MODE=
# Stripe: get sk_test_* / sk_live_* from Developers → API keys in the Stripe dashboard (restricted
# keys are rk_*); the webhook secret is the whsec_* given by `stripe listen` or the webhook
# endpoint page (not interchangeable with Creem's).
# With a live key (sk_live_ / rk_live_), BILLING_PROVIDER=fake is never allowed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Lemon Squeezy: get the API key from Settings → API and the signing secret from
# Settings → Webhooks in the LS dashboard. STORE_ID is the numeric store ID (checkout sessions
# require the store relationship). Test mode vs. live payments is a toggle on the store, and the
# key itself doesn't distinguish them, so there is no MODE variable — and there is **no** hard
# lock that forbids fake when a live key is set.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_STORE_ID=
# Waffo Pancake (used when BILLING_PROVIDER=waffo): create an API key under Dashboard →
# Integration and get the merchant ID (MER_…) and the private key (downloadable only once). The
# private key can be PEM, a single line of Base64, or text with literal \n.
# WAFFO_MODE defaults to test; set prod for real payments — an API key is bound to the test or
# production environment when it is created, so switching environments means switching keys.
# Webhooks are verified with the Waffo public key built into the SDK, so there's nothing to
# configure; if the public key rotates, you can override it with WAFFO_WEBHOOK_TEST_PUBLIC_KEY /
# WAFFO_WEBHOOK_PROD_PUBLIC_KEY (read by the SDK itself).
WAFFO_MERCHANT_ID=
WAFFO_PRIVATE_KEY=
WAFFO_MODE=
# Payment provider: defaults to `billing.provider` in site.config.ts (creem out of the box).
# creem | stripe | lemonsqueezy | waffo | fake.
# fake is only for local and CI e2e (on-site simulated checkout page and webhook). Setting it
# fails at startup in the production runtime (next build / next start / Docker), and it is also
# rejected on Vercel, with CREEM_MODE=live, and with a live Stripe key.
BILLING_PROVIDER=
# Explicitly allow fake (optional, off by default): only 1 / true count as on; 0 / false or unset
# mean off.
# CI's e2e runs against a production build and must set this; only set it on a self-hosted
# deployment if you explicitly need simulated payments.
# It only lifts the "production runtime" restriction; on Vercel, with CREEM_MODE=live, or with a
# live Stripe key, setting it still doesn't allow fake.
ALLOW_FAKE_BILLING=
# How long the success page waits for the webhook (milliseconds) before telling the user to
# contact support. Defaults to 60000.
BILLING_SUCCESS_TIMEOUT_MS=
# Rate limiting (Upstash Redis REST URL and token): required in Vercel production when ai, upload,
# or rateLimit is on. Locally, when unset, rate limiting is skipped; in self-hosted production
# (NODE_ENV=production and not on Vercel), when unset, the AI / upload / checkout endpoints
# return 503.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Explicitly allow "no Redis in the production runtime" (optional, off by default): only 1 / true
# count as on; 0 / false or unset mean off.
# With it set, self-hosted production without UPSTASH_* still skips rate limiting (a warning is
# logged at startup). CI's e2e runs against a production build without Upstash, so it must set
# this; a self-hosted deployment that explicitly doesn't want Redis can set it too, but then AI
# and upload have no rate limit.
ALLOW_UNRATELIMITED=
# File upload (Cloudflare R2): required in Vercel production when features.upload is on; locally,
# when unset, the upload endpoint returns 503.
# The Account ID is on the R2 overview page; the key and secret come from R2 → Manage API tokens
# (Object Read & Write).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public domain of the bucket (e.g. https://files.example.com); only needed when upload.public is
# true.
R2_PUBLIC_URL=
# Admin (/admin): comma-separated emails; signing in with one of these (verified) emails grants
# the admin role automatically.
# Required in Vercel production when features.admin is on. It only promotes, never demotes:
# removing an email does not take away an existing admin role.
ADMIN_EMAILS=
# AI provider keys: each provider is enabled when its key is set. With features.ai on, Vercel
# production requires a key for every provider used in ai.models.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Alibaba Cloud Model Studio (DashScope). Set ALIBABA_BASE_URL to match your key's region; when
# unset, the international site (Singapore) is used.
# Beijing region: https://dashscope.aliyuncs.com/compatible-mode/v1
ALIBABA_API_KEY=
ALIBABA_BASE_URL=
# Secret for the recovery endpoint (/api/cron/recovery), at least 16 characters (optional):
# openssl rand -hex 32
# Vercel cron sends Authorization: Bearer <secret> automatically; a self-hosted scheduler must
# send it itself when calling curl.
# The recovery sweep advances stuck AI jobs and resends critical emails that failed to go out
# (payment, low balance, verification codes).
# When unset, the endpoint returns 404 and the recovery sweep only runs opportunistically when
# users use AI features (see "Recovery sweep" in the README launch checklist).
CRON_SECRET=
# Observability: when features.observability and observability.otel are on, traces are exported
# to this OTLP endpoint (optional).
# Not needed on Vercel when using Tracing or the OTel integration; if auth is required, add
# OTEL_EXPORTER_OTLP_HEADERS (key=value, comma-separated).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
# Error tracking: the DSN is required when observability.sentry is on.
NEXT_PUBLIC_SENTRY_DSN=
# Optional: when all three are set, the build uploads source maps.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Development switches (not app configuration; you don't need them in deployed environments):
# Skip environment variable validation (optional). Only works when NODE_ENV is not production:
# next build / next start / Docker always validate, and setting this there has no effect —
# otherwise a single environment variable could bypass required variables and every module's
# production gates.
SKIP_ENV_VALIDATION=
