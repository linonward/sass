# 复制为 .env.local 后填写。各模块所需的变量由对应任务添加。

# 站点身份：site.config.ts 里出厂是占位值，直接改那个文件就行。
# 下面这组是给「一套代码、多个环境」用的覆盖项（模板的演示站就靠它保持真值，
# 也因此不必把真实名称写进仓库），一般不用填；填了就以这里为准。
# 没配这几个变量时，生产构建会因为占位值直接失败（见 src/core/config/sentinels.ts）。
# 产品名（site.config.ts 的 name）。官方演示设置为 OnwardKit；买家填自己的产品名。
SITE_NAME=
# 站点域名，不带协议（site.config.ts 的 domain）。
SITE_DOMAIN=
# 法律页里的公司或个人名称（site.config.ts 的 legal.companyName）。
SITE_LEGAL_NAME=
# 邮件发件地址（site.config.ts 的 email.fromAddress），域名要和发信服务商里验证过的一致。
SITE_EMAIL_FROM=
# 套餐产品 ID（site.config.ts 的 billing.plans[*].providerProductId），在服务商后台创建产品后获取。
# 变量名随生效的服务商走（site.config.ts 的 billing.provider，运行时可用 BILLING_PROVIDER 覆盖）：
# creem 是 prod_*，stripe 是 Price 的 price_*（订阅用按月循环价格，买断用一次性价格），
# lemonsqueezy 是变体（variant）ID，在产品详情页的「Variants」里建。
# 留着占位值（prod_placeholder_*）时对应套餐不能结账，接口返回 plan_not_configured。
CREEM_PRODUCT_ID_PRO=
CREEM_PRODUCT_ID_LIFETIME=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_LIFETIME=
LEMONSQUEEZY_VARIANT_ID_PRO=
LEMONSQUEEZY_VARIANT_ID_LIFETIME=

# 数据库：Postgres 连接地址（必填）。本地可用 Docker 起一个：
#   docker run -d --name sass-postgres -e POSTGRES_PASSWORD=postgres -p 5432:5432 postgres:18
# Neon 地址（*.neon.tech）自动走 WebSocket 驱动。
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
# 需要数据库的测试使用的库（可选；未设置时这些测试会跳过，CI 中必须设置）。
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5432/postgres
# 邮件发送方式：resend | console | file。
# 不填时：生产环境（含 Vercel 预览）为 resend，本地为 console（打印到终端）。
# 生产运行时（VERCEL_ENV 或 NODE_ENV 为 production）只允许 resend，设成 console / file 会启动失败：
# 这两种方式把登录验证码写进服务端日志或磁盘，不该出现在部署环境里。
EMAIL_TRANSPORT=
# 显式放行生产运行时的 console / file（可选，默认关闭）：只有 1 / true 算开启，写 0 / false 或不填都等同关闭。
# CI 的 e2e 跑在生产构建上、从 .tmp/emails/ 读验证码，必须设置它；只想在本地跑一次生产构建、没有发信 key 时也可以设。
ALLOW_NON_RESEND_EMAIL=
# Resend API key（re_ 开头）。EMAIL_TRANSPORT 为 resend 时必填。
RESEND_API_KEY=
# 登录（Better Auth）：签名 session 的密钥（必填，至少 32 个字符）。生成：openssl rand -base64 32
BETTER_AUTH_SECRET=
# 站点地址（可选）。不填时：本地按请求地址推断，Vercel 上取生产域名或本次部署的地址。
BETTER_AUTH_URL=
# Google 登录（可选；Vercel 生产环境必填）。不填时登录页只显示邮箱验证码登录。
# 填了之后登录页还会弹 One Tap 提示 —— 它要求当前 origin 登记在 Google Cloud Console 的
# Authorized JavaScript origins 里（见 README 的「登录（Google）」），没登记就静默不弹。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 收款：站点有付费套餐时 Vercel 生产环境必填；本地不填时结账和 webhook 接口返回 503。
# 只有**生效**服务商的那一组是必填的（选 Creem 就不必填 Stripe 的，反过来也一样）。
# Creem：在 Creem 后台 Developers 里获取；测试模式和生产模式的 key、webhook secret 不同。
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
# test（默认，走 test-api.creem.io，用测试卡）或 live（真实扣款）。
CREEM_MODE=
# Stripe：在 Stripe 后台 Developers → API keys 拿 sk_test_* / sk_live_*（受限密钥是 rk_*），
# webhook secret 是 `stripe listen` 或 Webhook 端点页面给的 whsec_*（和 Creem 的不通用）。
# 填了 live 密钥（sk_live_ / rk_live_）就一律不允许 BILLING_PROVIDER=fake。
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Lemon Squeezy：在 LS 后台 Settings → API 里拿 API key，在 Settings → Webhooks 里拿签名密钥；
# STORE_ID 是店铺 ID（数字，建结账会话必填 store 关系）。测试模式与真实收款是店铺上的一个开关，
# key 本身不区分，所以没有对应的 MODE 变量 —— 也**没有**「填了 live key 就不允许 fake」这条硬锁。
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_STORE_ID=
# 支付服务商：不填为 site.config.ts 的 billing.provider（出厂是 creem）。creem | stripe | lemonsqueezy | fake。
# fake 只用于本地和 CI 的 e2e（站内模拟结账页和 webhook），
# 生产运行时（next build / next start / Docker）设置会启动失败，Vercel、CREEM_MODE=live
# 和 live 的 Stripe 密钥下同样被拒绝。
BILLING_PROVIDER=
# 显式放行 fake（可选，默认关闭）：只有 1 / true 算开启，写 0 / false 或不填都等同关闭。
# CI 的 e2e 跑在生产构建上，必须设置它；自托管部署明确需要模拟支付时才设。
# 它只放开"生产运行时"这一条，Vercel 上、CREEM_MODE=live 或 live 的 Stripe 密钥时设置也不会放行。
ALLOW_FAKE_BILLING=
# 成功页等待 webhook 的时长（毫秒），超过后提示联系支持。默认 60000。
BILLING_SUCCESS_TIMEOUT_MS=
# 限流（Upstash Redis 的 REST 地址和 token）：开启 ai、upload 或 rateLimit 时 Vercel 生产环境必填；
# 本地不填时跳过限流；自托管生产（NODE_ENV=production 且不在 Vercel 上）不填时 AI / 上传 / 结账接口返回 503。
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# 显式放行「生产运行时不配 Redis」（可选，默认关闭）：只有 1 / true 算开启，写 0 / false 或不填都等同关闭。
# 设了它，自托管生产漏配 UPSTASH_* 时照旧跳过限流（启动日志里会有一条 warn）。CI 的 e2e 跑在生产构建
# 上、没有 Upstash，必须设置它；自托管部署明确不想接 Redis 时也可以设，但 AI / 上传就没有限流了。
ALLOW_UNRATELIMITED=
# 文件上传（Cloudflare R2）：开启 features.upload 时 Vercel 生产环境必填；本地不填时上传接口返回 503。
# Account ID 在 R2 概览页；key 和 secret 来自 R2 → Manage API tokens（Object Read & Write）。
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# bucket 的公开域名（例如 https://files.example.com），只在 upload.public 为 true 时需要。
R2_PUBLIC_URL=
# 后台（/admin）：逗号分隔的邮箱，用这些邮箱登录（邮箱已验证）时自动获得 admin 角色。
# 开启 features.admin 时 Vercel 生产环境必填。只提升不降级：删掉邮箱不会收回已有的 admin 角色。
ADMIN_EMAILS=
# AI 服务商的 key：填了哪家就启用哪家。开启 features.ai 时，Vercel 生产环境必须填上 ai.models 用到的每家。
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# 阿里云百炼（DashScope）。ALIBABA_BASE_URL 按 key 的地域填，不填是国际站（新加坡）；
# 北京地域：https://dashscope.aliyuncs.com/compatible-mode/v1
ALIBABA_API_KEY=
ALIBABA_BASE_URL=
# 恢复入口（/api/cron/recovery）的密钥，至少 16 个字符：openssl rand -hex 32（可选）。
# Vercel 的 cron 会自动带 Authorization: Bearer <它>；自托管的调度器 curl 时自己带。
# 恢复扫描推进悬着的 AI 任务、补发没发出去的关键邮件（付款、余额提醒、验证码）。
# 不设时入口返回 404，恢复扫描只在用户使用 AI 功能时顺带跑（见 README「恢复扫描」）。
CRON_SECRET=
# 可观测性：开启 features.observability 和 observability.otel 时，trace 导出到这个 OTLP 地址（可选）。
# 在 Vercel 上用 Tracing 或 OTel 集成时不用填；需要鉴权时加 OTEL_EXPORTER_OTLP_HEADERS（key=value，逗号分隔）。
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
# 错误追踪：开启 observability.sentry 时必填 DSN。
NEXT_PUBLIC_SENTRY_DSN=
# 可选：三项都填时构建会上传 source map。
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# 开发时的开关（不是应用配置，不需要在部署环境里填）：
# 跳过环境变量校验（可选）。只在 NODE_ENV 不是 production 时生效：
# next build / next start / Docker 里一律强制校验，设了也没用 ——
# 否则一个环境变量就能跳过必填项和各模块的生产闸门。
SKIP_ENV_VALIDATION=
